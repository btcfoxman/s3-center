{
  "manifest_version": 3,
  "name": "S3 Center Cloudflare Connector",
  "version": "2.0.0",
  "description": "Keeps each authorized Cloudflare identity in a native isolated browser profile with a fixed proxy.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://dash.cloudflare.com/*",
    "https://www.cloudflare.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["bootstrap.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://dash.cloudflare.com/*"],
      "js": ["panel.js"],
      "run_at": "document_idle"
    }
  ]
}
